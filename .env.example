# Application
NODE_ENV=development
PORT=3000
APP_NAME=EcommerceAPI

# Database
DATABASE_URL=postgresql://ecommerce:ecommerce123@localhost:5432/ecommerce_db?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=3d
JWT_REFRESH_TOKEN_EXPIRY=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment (Mock)
MOCK_PAYMENT_SUCCESS=true

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Platform Settings
PLATFORM_FEE_PERCENTAGE=5

# Logging
LOG_LEVEL=debug